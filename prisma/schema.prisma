// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id    String   @id @default(cuid())
  email String   @unique
  name  String?
  role  UserRole @default(RIDER)

  password   String   // This will store the hashed password
  isVerified Boolean  @default(false) // Tracks if email is verified

  driverRating Float? @default(5.0)
  riderRating  Float? @default(5.0)

  profileImageUrl String? // URL to the profile image
  
  createdAt DateTime @default(now())

  vehicles Vehicle[] // A user can have multiple vehicles
  rides    Ride[]    // A driver can post multiple rides
  rideRequests RideRequest[] // A user can post multiple requests
  authVerification AuthVerification?

  bookings         Booking[]     @relation("RiderBookings")
  acceptedBookings Booking[]     @relation("DriverBookings")
  chats            Chat[]        @relation("ChatParticipants")
  sentMessages     Message[]     @relation("MessageSender")
}

enum UserRole {
  RIDER
  DRIVER
}

model AuthVerification {
  id        String   @id @default(cuid())
  otp       String   // The 6-digit code
  expiresAt DateTime

  // This creates a 1-to-1 link to the User
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Vehicle {
  id           String @id @default(cuid())
  make         String // e.g., "Toyota"
  model        String // e.g., "Camry"
  licensePlate String @unique
  color        String

  // Relation to the User (Driver)
  driverId String
  driver   User   @relation(fields: [driverId], references: [id])

  rides    Ride[]
}

model RideRequest {
  id                     String    @id @default(cuid())
  desiredDepartureTime   DateTime
  canPayAmount           Decimal
  passengerCount         Int
  status                 RequestStatus @default(PENDING)
  createdAt              DateTime  @default(now())

  // Location Data
  srcDescription String
  srcLat         Float
  srcLng         Float
  dstDescription String
  dstLat         Float
  dstLng         Float
  
  // Relation to the rider
  riderId String
  rider   User   @relation(fields: [riderId], references: [id])

  booking Booking? @relation("RequestBooking")
}

enum RequestStatus {
  PENDING
  ACCEPTED
  CANCELLED
}

model Ride {
  id            String   @id @default(cuid())
  departureTime DateTime
  cost          Decimal
  totalSeats    Int
  
  seatsAvailable  Int
  status          RideStatus @default(SCHEDULED) 

  // Location Data
  srcDescription String
  srcLat         Float
  srcLng         Float
  dstDescription String
  dstLat         Float
  dstLng         Float

  driverId String
  driver   User   @relation(fields: [driverId], references: [id])
  
  vehicleId String   // The ride is associated with one specific vehicle
  vehicle   Vehicle  @relation(fields: [vehicleId], references: [id])

  bookings Booking[]
}

enum RideStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

model Booking {
  id          String        @id @default(cuid())
  seatsBooked Int
  status      BookingStatus @default(PENDING)
  createdAt   DateTime      @default(now())
  
  // Relation to the Ride
  rideId String
  ride   Ride   @relation(fields: [rideId], references: [id])
  
  // Relation to the Rider
  riderId String
  rider   User   @relation("RiderBookings", fields: [riderId], references: [id], onDelete: NoAction)
  
  // Relation to the Driver (denormalized for easy queries)
  driverId String
  driver   User   @relation("DriverBookings", fields: [driverId], references: [id], onDelete: NoAction)

  // This is for when a request is accepted (Scenario B)
  rideRequestId String?  @unique
  rideRequest   RideRequest? @relation("RequestBooking", fields: [rideRequestId], references: [id])

  // A booking, once confirmed, will have one chat
  chat Chat?
}

model Chat {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt // Automatically updates on change

  // 1-to-1 relation with a Booking
  bookingId String  @unique
  booking   Booking @relation(fields: [bookingId], references: [id])
  
  // Many-to-Many relation with Users
  participants User[]      @relation("ChatParticipants")
  messages     Message[]
}

model Message {
  id        String   @id @default(cuid())
  text      String   
  createdAt DateTime @default(now())

  // Relation to the Chat.tsx
  chatId String
  chat   Chat   @relation(fields: [chatId], references: [id])
  
  // Relation to the User who sent it
  senderId String
  sender   User   @relation("MessageSender", fields: [senderId], references: [id])
}

enum BookingStatus {
  PENDING    // Rider requested to book
  CONFIRMED  // Driver accepted
  REJECTED   // Driver rejected
  CANCELLED  // Rider or Driver cancelled
}