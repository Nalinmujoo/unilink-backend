// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id    String   @id @default(cuid())
  email String   @unique
  name  String?
  role  UserRole @default(RIDER)

  password   String   // This will store the hashed password
  isVerified Boolean  @default(false) // Tracks if email is verified

  driverRating Float? @default(5.0)
  riderRating  Float? @default(5.0)

  createdAt DateTime @default(now())

  vehicles Vehicle[] // A user can have multiple vehicles
  rides    Ride[]    // A driver can post multiple rides
  authVerification AuthVerification?
}

enum UserRole {
  RIDER
  DRIVER
}

model AuthVerification {
  id        String   @id @default(cuid())
  otp       String   // The 6-digit code
  expiresAt DateTime

  // This creates a 1-to-1 link to the User
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Vehicle {
  id           String @id @default(cuid())
  make         String // e.g., "Toyota"
  model        String // e.g., "Camry"
  licensePlate String @unique
  color        String

  // Relation to the User (Driver)
  driverId String
  driver   User   @relation(fields: [driverId], references: [id])

  rides    Ride[]
}

model Ride {
  id            String   @id @default(cuid())
  departureTime DateTime
  cost          Decimal
  totalSeats    Int
  
  seatsAvailable  Int
  status          RideStatus @default(SCHEDULED) 

  // Location Data
  srcDescription String
  srcLat         Float
  srcLng         Float
  dstDescription String
  dstLat         Float
  dstLng         Float

  driverId String
  driver   User   @relation(fields: [driverId], references: [id])
  
  vehicleId String   // The ride is associated with one specific vehicle
  vehicle   Vehicle  @relation(fields: [vehicleId], references: [id])
}

enum RideStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}